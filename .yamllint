---
extends: default

ignore: |
  .git/
  .venv/
  .ansible/

rules:
  line-length:
    max: 120
  truthy:
    allowed-values: ['true', 'false']
    check-keys: false
  # Required for ansible-lint compatibility (see .ansible-lint / yaml rule).
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
